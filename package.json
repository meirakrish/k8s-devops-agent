{
  "name": "k8s-devops-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Kubernetes health checks with LLM triage and root-cause investigation",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meirakrish/k8s-devops-agent.git"
  },
  "homepage": "https://github.com/meirakrish/k8s-devops-agent#readme",
  "bugs": {
    "url": "https://github.com/meirakrish/k8s-devops-agent/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "check": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "demo:up": "bash scripts/demo.sh up",
    "demo:check": "bash scripts/demo.sh check",
    "demo:status": "bash scripts/demo.sh status",
    "demo:reset": "bash scripts/demo.sh reset",
    "demo:down": "bash scripts/demo.sh down"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@meirakrish/llm-kit": "github:meirakrish/llm-kit#ad3e32db31c7f4fda83d940ef229c1a07d6b7661",
    "dotenv": "^18.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
